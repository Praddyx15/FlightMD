[GRAMMAR]
ELEMENTS:
- TAG: SECTION
  PROPERTIES:
    IS_COMPOSITE: True
  FIELDS:
  - TITLE: UID
    TYPE: String
    REQUIRED: False
  - TITLE: TITLE
    TYPE: String
    REQUIRED: True
- TAG: TEXT
  FIELDS:
  - TITLE: UID
    TYPE: String
    REQUIRED: False
  - TITLE: STATEMENT
    TYPE: String
    REQUIRED: True
- TAG: REQUIREMENT
  FIELDS:
  - TITLE: UID
    TYPE: String
    REQUIRED: True
  - TITLE: STATUS
    TYPE: SingleChoice(Proposed, Active, Deleted)
    REQUIRED: True
  - TITLE: TITLE
    TYPE: String
    REQUIRED: True
  - TITLE: STATEMENT
    TYPE: String
    REQUIRED: True
  - TITLE: RATIONALE
    TYPE: String
    REQUIRED: False
  - TITLE: SOURCE
    TYPE: String
    REQUIRED: False
  - TITLE: VERIFICATION
    TYPE: MultipleChoice(Test, Analysis, Inspection, Demonstration)
    REQUIRED: False
  - TITLE: VERIFICATION_NOTE
    TYPE: String
    REQUIRED: False
  - TITLE: ALLOCATION
    TYPE: MultipleChoice(intake, parsers, analysers, report, api, web, tools, data, deployment, procedure)
    REQUIRED: False
  - TITLE: DERIVED
    TYPE: SingleChoice(Yes, No)
    REQUIRED: False
  - TITLE: COMMENT
    TYPE: String
    REQUIRED: False
  RELATIONS:
  - TYPE: Parent
