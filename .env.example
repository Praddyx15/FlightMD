# Copy to .env (repo root) and fill in what you need. Everything is optional.

# AI: polished summaries and the Q&A box. Analysis is fully deterministic and
# works without it. AI_PROVIDER is "groq" (free tier) or "anthropic"; only the
# selected provider's key is needed.
AI_PROVIDER=groq
# keys: https://console.groq.com/keys and https://console.anthropic.com
# GROQ_API_KEY=gsk_your-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here

MAX_FILE_SIZE_MB=50
MAX_CONCURRENT_ANALYSES=2

# Engine (also read by the CLI)
# FLIGHTMD_OFFLINE=1          skip weather, reverse geocoding and AI polish
# FLIGHTMD_MAX_LOG_MB=512     refuse logs bigger than this
# FLIGHTMD_PARSE_TIMEOUT_S=600  parse in a child process and stop it after this; 0 = in-process

# Per client IP, per hour
RATE_LIMIT_PER_HOUR=10
ASK_RATE_LIMIT_PER_HOUR=30
PDF_RATE_LIMIT_PER_HOUR=30

# Reverse proxies whose X-Forwarded-For header is trusted (comma-separated IPs
# or CIDRs). Leave empty when clients connect directly. Never use 0.0.0.0/0:
# that lets any client pick its own rate-limit key.
# TRUSTED_PROXIES=10.0.0.0/8

# Alert webhooks must be https unless this is true
# ALLOW_HTTP_WEBHOOKS=false

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# production: CORS_ORIGINS=https://flightmd.vercel.app

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
# production: NEXT_PUBLIC_API_URL=https://flightmd-api.onrender.com

# Map tiles, if you'd rather not hit openstreetmap.org directly
# NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
