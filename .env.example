# Copy to .env (repo root) and fill in what you need. Everything is optional.

# AI: polished summaries and the Q&A box. Analysis is fully deterministic and
# works without it. AI_PROVIDER is "groq" (free tier) or "anthropic"; only the
# selected provider's key is needed.
AI_PROVIDER=groq
# keys: https://console.groq.com/keys and https://console.anthropic.com
# GROQ_API_KEY=gsk_your-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here

MAX_FILE_SIZE_MB=50
MAX_CONCURRENT_ANALYSES=2

# Engine (also read by the CLI)
# FLIGHTMD_OFFLINE=1          skip weather, reverse geocoding and AI polish
# FLIGHTMD_MAX_LOG_MB=512     refuse logs bigger than this
# FLIGHTMD_PARSE_TIMEOUT_S=600  parse in a child process and stop it after this; 0 = in-process

# Where the API keeps its SQLite database (flightmd.db), the upload spool, the
# export cache and contributed logs. The engine's topic cache goes in <dir>/cache.
# Relative to the working directory. Old api/data/ JSON files are imported on start.
# FLIGHTMD_DATA_DIR=./data
# FLIGHTMD_CACHE_TTL_S=3600
# FLIGHTMD_CACHE=1            parsed-topic cache, on by default when FLIGHTMD_DATA_DIR is set
# FLIGHTMD_CACHE_MAX_MB=1024
# FLIGHTMD_CORPUS_DIR=tests/corpus/logs   where pytest -m corpus keeps downloaded logs

# Contributed logs in S3-compatible storage instead of FLIGHTMD_DATA_DIR/blobs (pip extra: s3)
# FLIGHTMD_S3_BUCKET=
# FLIGHTMD_S3_PREFIX=flightmd/
# FLIGHTMD_S3_ENDPOINT_URL=
# FLIGHTMD_S3_REGION=

# DJI flight records v13+ are encrypted; decrypting them sends key ciphertexts to DJI
# (pip extra: dji). Ignored when FLIGHTMD_OFFLINE=1.
# DJI_API_KEY=

# Contributed raw logs in S3 or anything S3-compatible (needs flightmd-core[s3]).
# Credentials come from the usual AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
# FLIGHTMD_S3_BUCKET=my-flightmd-logs
# FLIGHTMD_S3_PREFIX=contributions/
# FLIGHTMD_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# FLIGHTMD_S3_REGION=auto

# Hand analyses to arq workers via Redis instead of the in-process queue
# (needs flightmd-core[queue]; run `arq api.worker.WorkerSettings`). Needed when
# running more than one API process.
# FLIGHTMD_REDIS_URL=redis://localhost:6379

# GET /metrics is open unless this is set; then send "Authorization: Bearer <token>"
# METRICS_TOKEN=

# Per client IP, per hour
RATE_LIMIT_PER_HOUR=10
ASK_RATE_LIMIT_PER_HOUR=30
PDF_RATE_LIMIT_PER_HOUR=30

# Reverse proxies whose X-Forwarded-For header is trusted (comma-separated IPs
# or CIDRs). Leave empty when clients connect directly. Never use 0.0.0.0/0:
# that lets any client pick its own rate-limit key.
# TRUSTED_PROXIES=10.0.0.0/8

# Alert webhooks must be https unless this is true
# ALLOW_HTTP_WEBHOOKS=false

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# production: CORS_ORIGINS=https://flightmd.vercel.app

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side address of the API for the Next server (docker compose: http://api:8000)
# API_URL=http://localhost:8000
# production: NEXT_PUBLIC_API_URL=https://flightmd-api.onrender.com

# Map tiles, if you'd rather not hit openstreetmap.org directly
# NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
