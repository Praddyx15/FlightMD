# FlightMD Environment Variables
# Copy this file to .env and fill in your values

# ── Optional AI enhancement ─────────────────────────────────────────────────────
# Optional — enables AI-polished executive summaries and the AI Q&A assistant.
# The platform performs full deterministic analysis and works completely
# offline without any of this set.
#
# AI_PROVIDER selects which one is used: "groq" (recommended default — free
# tier, no cost to run) or "anthropic" (Claude, if you have a key and want
# that quality). Only the key for the selected provider needs to be set.
AI_PROVIDER=groq

# Free — get a key at https://console.groq.com/keys (no phone verification)
# GROQ_API_KEY=gsk_your-key-here

# Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── File limits ───────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_HOUR=10

# ── CORS (comma-separated list of allowed origins) ────────────────────────────
# Development:
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Production (set in Render dashboard or render.yaml):
# CORS_ORIGINS=https://flightmd.vercel.app

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# Development:
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production (set in Vercel dashboard or vercel.json):
# NEXT_PUBLIC_API_URL=https://flightmd-api.onrender.com
