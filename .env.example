# FlightMD Environment Variables
# Copy this file to .env and fill in your values

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Required: Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Models (defaults are fine, change only if you want to experiment) ──────────
CLAUDE_FAST_MODEL=claude-haiku-4-5
CLAUDE_SUMMARY_MODEL=claude-sonnet-4-6

# ── File limits ───────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_HOUR=10

# ── CORS (comma-separated list of allowed origins) ────────────────────────────
# Development:
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Production (set in Render dashboard or render.yaml):
# CORS_ORIGINS=https://flightmd.vercel.app

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# Development:
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production (set in Vercel dashboard or vercel.json):
# NEXT_PUBLIC_API_URL=https://flightmd-api.onrender.com
